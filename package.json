{
  "name": "Kavero",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UpstandPlatform/kavero.git"
  },
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/node": "^26.4.1",
      "varlock": "1.23.0",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "better-auth": "1.7.12",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev -F web",
    "setup": "bun scripts/setup-dev.ts",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:desktop": "bun run --filter @Kavero/desktop dev",
    "build:desktop": "turbo run build -F web && bun run --filter @Kavero/desktop dist",
    "test": "bun test packages",
    "db:push": "turbo run db:push -F @Kavero/db --",
    "db:studio": "turbo run db:studio -F @Kavero/db --",
    "db:generate": "turbo run db:generate -F @Kavero/db --",
    "db:migrate": "turbo run db:migrate -F @Kavero/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate",
    "make-admin": "bun run --filter @Kavero/db make-admin --"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Kavero/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.4.2"
}
