{
  "name": "@Kavero/desktop",
  "version": "0.11.0",
  "private": true,
  "productName": "Kavero",
  "description": "Kavero desktop app (Electron shell around the Kavero web app)",
  "author": "Kavero",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && bun scripts/bundle-main.mjs",
    "dev": "bun run build && electron .",
    "smoke": "bun run build && electron . --smoke",
    "prepare-web": "node scripts/prepare-web.mjs",
    "dist": "bun run build && node scripts/prepare-web.mjs && node scripts/dist.mjs",
    "dist:dir": "bun run build && node scripts/prepare-web.mjs && node scripts/dist.mjs --dir",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "icons": "bun scripts/make-icons.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UpstandPlatform/Kavero.git"
  }
}
