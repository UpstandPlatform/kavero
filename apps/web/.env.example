# Copy to apps/web/.env and fill in. See docs/deployment.md for every option.

NODE_ENV=development
# Postgres from `bun run db:start` (docker compose, host port 5436)
DATABASE_URL=postgresql://postgres:password@localhost:5436/Kavero
# Redis from bun run db:start (local development); Compose uses redis://redis:6379 internally.
REDIS_URL=redis://localhost:6379
# 32+ random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Always open Kavero at exactly this address (cookies are per host).
BETTER_AUTH_URL=http://localhost:3001

# Optional media sources. Unconfigured sources are hidden from the media library.
# Enable Openverse stock image search:
# NEXT_PUBLIC_OPENVERSE_ENABLED=true
# GIPHY API key for client-side GIF search (public browser key):
# NEXT_PUBLIC_GIPHY_API_KEY=

# Optional: AI model (otherwise the built-in planner is used)
# ANTHROPIC_API_KEY=
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2

# Optional: S3-compatible storage instead of the local .storage folder
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
