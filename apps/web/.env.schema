# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# --- Asset storage (optional) ---

# Where uploaded images/fonts and generated OG images are stored
# @optional @public @type=enum(filesystem, s3)
STORAGE_DRIVER=filesystem

# Folder for the filesystem driver (default: <cwd>/.storage)
# @optional @public @type=string
KAVERO_STORAGE_DIR=

# Bucket for the s3 driver (AWS S3, Cloudflare R2, MinIO)
# @optional @public @type=string
S3_BUCKET=

# Region; use "auto" for Cloudflare R2 (default: us-east-1, or auto when S3_ENDPOINT is set)
# @optional @public @type=string
S3_REGION=

# Custom endpoint for R2/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
# @optional @public @type=url
S3_ENDPOINT=

# @optional @type=string
S3_ACCESS_KEY_ID=

# @optional @type=string
S3_SECRET_ACCESS_KEY=

# Path-style URLs (needed for MinIO)
# @optional @public @type=boolean
S3_FORCE_PATH_STYLE=

# --- Export tooling (optional; auto-detected when unset) ---

# Chrome/Chromium executable for PDF/video/preview rendering
# @optional @public @type=string
KAVERO_CHROME_PATH=

# ffmpeg executable for video export (default: bundled @ffmpeg-installer binary)
# @optional @public @type=string
FFMPEG_PATH=

# --- AI (optional; without a model, Kavero's built-in planner is used) ---

# anthropic | openai | openai-compatible | none (default: first configured)
# @optional @public @type=string
AI_PROVIDER=

# Model id (default for Anthropic: claude-opus-5-5; required for OpenAI-compatible)
# @optional @public @type=string
AI_MODEL=

# @optional @type=string
ANTHROPIC_API_KEY=

# @optional @type=string
OPENAI_API_KEY=

# OpenAI-compatible base URL, e.g. http://localhost:11434/v1 for Ollama
# @optional @public @type=url
AI_BASE_URL=

# ---------- Exports and security ----------

# Address the export browser uses to reach this app (defaults to BETTER_AUTH_URL).
# Set it to an internal address when the server can't reach its own public URL, e.g. in Docker.
# @optional @public @type=url
KAVERO_RENDER_URL=

# Most headless Chrome exports (PDF, JPG, video, previews) running at once (default 2).
# @optional @public @type=number
KAVERO_MAX_BROWSERS=

# Set when Kavero runs behind a reverse proxy: "true" (one proxy) or the number of proxy hops.
# Used to find the visitor's IP for password-protected sites' brute-force protection.
# @optional @public @type=string
TRUST_PROXY=

# ---------- Desktop app (set by apps/desktop; leave unset on servers) ----------

# "1" = the desktop app's own local server: one automatic local account, no sign-in screens.
# @optional @public @type=enum(0, 1)
KAVERO_LOCAL_MODE=

# "1" = apply database migrations on startup from KAVERO_MIGRATIONS_DIR.
# @optional @type=enum(0, 1)
KAVERO_AUTO_MIGRATE=

# @optional @type=string
KAVERO_MIGRATIONS_DIR=
